---
import AdminLayout from '../layouts/AdminLayout.astro';
import { ICONS } from '../lib/icons.ts';
---

<AdminLayout title="Customers" active="customers" crumbs={[{ label: 'Customers' }]}>
  <div class="page-head">
    <div>
      <h1>Customers</h1>
      <p class="lead">Everyone who has shopped with us. Guests check out without an account; members belong to the Stanley 1913 Club and earn points.</p>
    </div>
    <div class="actions"><button class="c-btn" type="button" data-new><Fragment set:html={ICONS.plus} /> add customer</button></div>
  </div>
  <section data-table></section>

  <script>
    import '../lib/boot.ts';
    import { all, insert, update, remove, keyOf } from '../lib/db.ts';
    import { mountTable, openForm, confirmDialog, attempt, rowButtons } from '../lib/ui.ts';
    import { rupiah, esc, date, tier, number } from '../lib/format.ts';
    import { membershipOf, orderTotal, nowLocal } from '../lib/derive.ts';
    import { log } from '../lib/activity.ts';
    import type { Row } from '../lib/schema.ts';

    const ordersOf = (c: Row) => all('orders').filter((o) => o.customer_id === c.customer_id);
    const spend = (c: Row) => ordersOf(c).filter((o) => o.order_type === 'regular' && o.status === 'completed').reduce((s, o) => s + orderTotal(o), 0);

    function edit(c?: Row) {
      openForm({
        title: c ? 'Edit customer' : 'Add customer',
        subtitle: c ? undefined : 'New customers start as guests. You can make them a Club member from their profile.',
        fields: [
          { name: 'full_name', label: 'Full name', required: true, full: true },
          { name: 'email', label: 'Email', type: 'email', required: true, help: 'Each email can only be used once.' },
          { name: 'phone', label: 'Phone', type: 'tel', required: true, placeholder: '0812xxxxxxxx' },
        ],
        values: c,
        submit: c ? 'save' : 'add customer',
        success: c ? 'Customer saved' : 'Customer added',
        onSubmit: (v) => {
          if (c) { update('customer', c.customer_id, v); log('update', 'customer', `Edited customer ${v.full_name}`); }
          else { const r = insert('customer', { ...v, created_at: nowLocal() }); log('create', 'customer', `Added customer ${r.full_name}`); }
        },
      });
    }

    const t = mountTable(document.querySelector('[data-table]')!, {
      rows: () => all('customer'),
      rowKey: (r) => keyOf('customer', r),
      search: (r) => `${r.full_name} ${r.email} ${r.phone}`,
      searchPlaceholder: 'Search name, email, phone…',
      csvName: 'customers',
      defaultSort: { key: 'full_name', dir: 1 },
      filters: [
        { key: 'kind', label: 'Type', options: [['member', 'Member'], ['guest', 'Guest']], test: (r, v) => (v === 'member') === !!membershipOf(r.customer_id) },
        { key: 'tier', label: 'Tier', options: [['member', 'Member'], ['vip', 'VIP'], ['all_access', 'All-Access']], test: (r, v) => membershipOf(r.customer_id)?.tier === v },
      ],
      columns: [
        { key: 'full_name', label: 'Customer', sort: (r) => r.full_name, html: (r) => `<a href="/customer?id=${r.customer_id}"><b>${esc(r.full_name)}</b></a><br><small class="muted">${esc(r.email)}</small>`, csv: (r) => r.full_name },
        { key: 'email', label: 'Email', hidden: true, html: () => '', csv: (r) => r.email },
        { key: 'phone', label: 'Phone', cls: 'num', html: (r) => esc(r.phone), csv: (r) => r.phone },
        { key: 'tier', label: 'Club', sort: (r) => membershipOf(r.customer_id)?.total_points ?? -1, html: (r) => { const m = membershipOf(r.customer_id); return m ? tier(m.tier) : '<span class="muted">Guest</span>'; }, csv: (r) => membershipOf(r.customer_id)?.tier ?? 'guest' },
        { key: 'points', label: 'Points', cls: 'right num', sort: (r) => membershipOf(r.customer_id)?.total_points ?? -1, html: (r) => { const m = membershipOf(r.customer_id); return m ? number(m.total_points) : '—'; }, csv: (r) => membershipOf(r.customer_id)?.total_points ?? '' },
        { key: 'orders', label: 'Orders', cls: 'right num', sort: (r) => ordersOf(r).length, html: (r) => String(ordersOf(r).length), csv: (r) => ordersOf(r).length },
        { key: 'spend', label: 'Total spent', cls: 'right num', sort: spend, html: (r) => rupiah(spend(r)), csv: spend },
        { key: 'created_at', label: 'Joined', cls: 'num', sort: (r) => r.created_at, html: (r) => date(r.created_at), csv: (r) => r.created_at },
      ],
      actions: () => rowButtons([{ act: 'edit', label: 'Edit', ic: 'edit' }, { act: 'del', label: 'Delete', ic: 'trash' }]),
      onRow: (r) => (location.href = `/customer?id=${r.customer_id}`),
    });

    document.querySelector('[data-table]')!.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      const row = b && t.rowFromEvent(e);
      if (!b || !row) return;
      if (b.dataset.act === 'edit') edit(row);
      if (b.dataset.act === 'del') {
        const ok = await confirmDialog({
          title: `Delete ${row.full_name}?`,
          body: "Their membership, saved addresses, personal promo codes and reviews are removed too. Customers with orders or warranty claims can't be deleted.",
          confirm: 'delete customer',
          danger: true,
        });
        if (ok) attempt(() => { remove('customer', row.customer_id); log('delete', 'customer', `Deleted customer ${row.full_name}`); }, 'Customer deleted');
      }
    });
    document.querySelector('[data-new]')!.addEventListener('click', () => edit());
  </script>
</AdminLayout>
