---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Customer details" active="customers" crumbs={[{ label: 'Customers', href: '/customers' }, { label: 'Details' }]}>
  <div data-root class="stack"></div>

  <script>
    import '../lib/boot.ts';
    import { get, insert, update, remove, onChange, where } from '../lib/db.ts';
    import { attempt, confirmDialog, openForm, stars, type FieldDef } from '../lib/ui.ts';
    import { rupiah, esc, date, dateTime, badge, tier, number, enumLabel } from '../lib/format.ts';
    import { membershipOf, orderTotal, nowLocal, pointsFor, tierFor, localDate } from '../lib/derive.ts';
    import { log } from '../lib/activity.ts';
    import { icon } from '../lib/icons.ts';
    import type { Row } from '../lib/schema.ts';

    const id = Number(new URLSearchParams(location.search).get('id'));
    const root = document.querySelector<HTMLElement>('[data-root]')!;
    const b64 = './ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    const fakeHash = () => '$2b$10$' + Array.from(crypto.getRandomValues(new Uint8Array(53)), (n) => b64[n % 64]).join('');

    const addrFields: FieldDef[] = [
      { name: 'label', label: 'Label', required: true, placeholder: 'Home / Office' },
      { name: 'recipient_name', label: 'Recipient', required: true },
      { name: 'recipient_phone', label: 'Recipient phone', type: 'tel', required: true },
      { name: 'postal_code', label: 'Postal code', required: true, placeholder: '12430' },
      { name: 'street_address', label: 'Street address', required: true, full: true },
      { name: 'city', label: 'City', required: true },
      { name: 'province', label: 'Province', required: true },
    ];

    function render() {
      const c = get('customer', id);
      if (!c) {
        root.innerHTML = `<div class="panel"><div class="empty">${icon('inbox')}<span>This customer could not be found.</span><a class="c-btn c-btn--outline c-btn--sm" href="/customers">back to customers</a></div></div>`;
        return;
      }
      document.title = `${c.full_name} | Stanley 1913 Admin`;
      const m = membershipOf(id);
      const addrs = m ? where('customer_address', (a) => a.membership_id === m.membership_id) : [];
      const orders = where('orders', (o) => o.customer_id === id).sort((a, b) => (a.ordered_at < b.ordered_at ? 1 : -1));
      const reviews = where('review', (r) => r.customer_id === id);
      const claims = where('warranty_claim', (w) => w.customer_id === id);
      const promos = m ? where('promo_code', (p) => p.membership_id === m.membership_id) : [];
      const earned = orders.filter((o) => o.status === 'completed' && o.order_type === 'regular').reduce((s, o) => s + pointsFor(orderTotal(o)), 0);
      const next = m ? (m.total_points < 300 ? 300 - m.total_points : m.total_points < 600 ? 600 - m.total_points : 0) : 0;

      root.innerHTML = `
      <div class="page-head">
        <div>
          <h1>${esc(c.full_name)}</h1>
          <p class="lead">${m ? tier(m.tier) : '<span class="badge plain">Guest</span>'} · joined ${date(c.created_at)}</p>
        </div>
        <div class="actions"><button class="c-btn c-btn--outline" data-act="edit">${icon('edit')} edit profile</button></div>
      </div>
      <div class="grid-2">
        <div class="stack">
          <section class="panel">
            <div class="panel-head"><h2>Orders</h2><span class="muted">${orders.length}</span></div>
            <div class="table-wrap"><table class="data"><thead><tr><th>Order</th><th>Date</th><th class="right">Total</th><th>Status</th></tr></thead><tbody>
            ${orders.map((o) => `<tr><td><a class="mono" href="/order?id=${o.order_id}">${esc(o.order_number)}</a>${o.order_type === 'warranty_replacement' ? ' <span class="badge plain">replacement</span>' : ''}</td><td class="num">${dateTime(o.ordered_at)}</td><td class="right num">${rupiah(orderTotal(o))}</td><td>${badge(o.status)}</td></tr>`).join('') || `<tr><td colspan="4"><div class="empty">No orders yet.</div></td></tr>`}
            </tbody></table></div>
          </section>

          <section class="panel">
            <div class="panel-head"><h2>Saved addresses</h2>
              <div class="actions">${m ? `<button class="c-btn c-btn--outline c-btn--sm" data-act="addr-new">${icon('plus')} add address</button>` : ''}</div></div>
            ${m ? `<div class="table-wrap"><table class="data"><thead><tr><th>Label</th><th>Recipient</th><th>Address</th><th></th></tr></thead><tbody>
              ${addrs.map((a) => `<tr data-addr="${a.customer_address_id}"><td><b>${esc(a.label)}</b></td><td>${esc(a.recipient_name)}<br><small class="muted num">${esc(a.recipient_phone)}</small></td><td>${esc(a.street_address)}, ${esc(a.city)}, ${esc(a.province)} <span class="num">${esc(a.postal_code)}</span></td>
                <td class="actions"><button class="c-btn c-btn--ghost c-btn--icon" data-act="addr-edit" aria-label="Edit address" title="Edit">${icon('edit')}</button><button class="c-btn c-btn--ghost c-btn--icon" data-act="addr-del" aria-label="Delete address" title="Delete">${icon('trash')}</button></td></tr>`).join('') || `<tr><td colspan="4"><div class="empty">No saved addresses.</div></td></tr>`}
              </tbody></table></div>` : '<div class="panel-body"><p class="muted">Guests don\'t save addresses; they enter one at checkout.</p></div>'}
          </section>

          ${reviews.length ? `<section class="panel"><div class="panel-head"><h2>Reviews</h2><span class="muted">${reviews.length}</span></div>
            <ul class="feed">${reviews.map((r) => { const p = get('product', r.product_id); return `<li><span class="ic">${icon('review')}</span><div><b>${esc(r.title)}</b> ${stars(r.rating)}<small>${esc(p?.name)} · ${esc(p?.color)}</small></div><time>${date(r.created_at)}</time></li>`; }).join('')}</ul></section>` : ''}
        </div>

        <div class="stack">
          <section class="panel">
            <div class="panel-head"><h2>Profile</h2></div>
            <div class="panel-body"><dl class="dl">
              <dt>Email</dt><dd>${esc(c.email)}</dd>
              <dt>Phone</dt><dd class="num">${esc(c.phone)}</dd>
              <dt>Warranty claims</dt><dd>${claims.length ? claims.map((w) => `<a class="mono" href="/warranty-claims?q=${encodeURIComponent(w.claim_number)}">${esc(w.claim_number)}</a> ${badge(w.status)}`).join('<br>') : '—'}</dd>
            </dl></div>
          </section>

          <section class="panel">
            <div class="panel-head"><h2>Stanley 1913 Club</h2></div>
            <div class="panel-body stack" style="gap:16px">
            ${m ? `<dl class="dl">
                <dt>Tier</dt><dd>${tier(m.tier)}</dd>
                <dt>Points</dt><dd class="num"><b>${number(m.total_points)}</b> <small class="muted">(${number(earned)} from completed orders)</small></dd>
                <dt>Tier valid until</dt><dd>${m.tier_valid_until ? date(m.tier_valid_until) : '—'}</dd>
                <dt>Birthday</dt><dd>${date(m.birth_date)}</dd>
                <dt>Member since</dt><dd>${date(m.registered_at)}</dd>
              </dl>
              ${next ? `<p class="note">${number(next)} more points to ${m.total_points < 300 ? 'VIP (300 points)' : 'All-Access (600 points)'}.</p>` : ''}
              ${promos.length ? `<p class="note">Personal codes: ${promos.map((p) => `<code>${esc(p.code)}</code>`).join(', ')}</p>` : ''}
              <div class="inline-actions">
                <button class="c-btn c-btn--outline c-btn--sm" data-act="mem-edit">${icon('edit')} edit membership</button>
                <button class="c-btn c-btn--ghost c-btn--sm" data-act="mem-del">remove membership</button>
              </div>`
              : `<p class="muted">This customer is a guest. Add a membership so they can collect points and save addresses.</p>
                 <div><button class="c-btn c-btn--sm" data-act="mem-new">${icon('plus')} make member</button></div>`}
            </div>
          </section>
        </div>
      </div>`;
    }

    function memberForm(m?: Row) {
      openForm({
        title: m ? 'Edit membership' : 'Make member',
        subtitle: 'A tier stays valid for 12 months.',
        fields: [
          { name: 'tier', label: 'Tier', type: 'select', required: true, options: [['member', 'Member'], ['vip', 'VIP (300+ points)'], ['all_access', 'All-Access (600+ points)']] },
          { name: 'total_points', label: 'Points', type: 'number', required: true, min: 0 },
          { name: 'tier_valid_until', label: 'Tier valid until', type: 'date' },
          { name: 'birth_date', label: 'Birthday', type: 'date' },
        ],
        values: m ?? { tier: 'member', total_points: 0 },
        submit: m ? 'save' : 'make member',
        success: m ? 'Membership saved' : 'Customer is now a member',
        onSubmit: (v) => {
          const fx: string[] = [];
          if (tierFor(Number(v.total_points)) !== v.tier) fx.push(`Note: ${v.total_points} points usually means ${enumLabel(tierFor(Number(v.total_points)))}.`);
          if (m) { update('membership', m.membership_id, v); log('update', 'membership', `Edited membership for ${get('customer', id)!.full_name}`); }
          else {
            insert('membership', { ...v, customer_id: id, password_hash: fakeHash(), registered_at: nowLocal(), tier_valid_until: v.tier_valid_until || (v.tier !== 'member' ? localDate(new Date(Date.now() + 365 * 864e5)) : null) });
            log('create', 'membership', `${get('customer', id)!.full_name} became a member`);
          }
          return fx;
        },
      });
    }

    function addrForm(a?: Row) {
      const m = membershipOf(id)!;
      openForm({
        title: a ? 'Edit address' : 'New address',
        fields: addrFields,
        values: a ?? { recipient_name: get('customer', id)!.full_name, recipient_phone: get('customer', id)!.phone },
        submit: a ? 'save' : 'add address',
        success: a ? 'Address saved' : 'Address added',
        onSubmit: (v) => {
          if (a) { update('customer_address', a.customer_address_id, v); log('update', 'customer_address', `Edited address ${v.label}`); }
          else { insert('customer_address', { ...v, membership_id: m.membership_id }); log('create', 'customer_address', `Added address ${v.label}`); }
        },
      });
    }

    root.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      if (!b) return;
      const c = get('customer', id)!;
      const m = membershipOf(id);
      const addrId = Number(b.closest<HTMLElement>('[data-addr]')?.dataset.addr);
      switch (b.dataset.act) {
        case 'edit':
          openForm({
            title: 'Edit profile',
            fields: [
              { name: 'full_name', label: 'Full name', required: true, full: true },
              { name: 'email', label: 'Email', type: 'email', required: true },
              { name: 'phone', label: 'Phone', type: 'tel', required: true },
            ],
            values: c,
            submit: 'save',
            success: 'Profile saved',
            onSubmit: (v) => { update('customer', id, v); log('update', 'customer', `Edited customer ${v.full_name}`); },
          });
          break;
        case 'mem-new': memberForm(); break;
        case 'mem-edit': memberForm(m); break;
        case 'mem-del':
          if (await confirmDialog({ title: 'Remove membership?', body: 'The customer becomes a guest again. Their saved addresses and personal promo codes are removed too.', confirm: 'remove membership', danger: true }))
            attempt(() => { remove('membership', m!.membership_id); log('delete', 'membership', `Removed membership for ${c.full_name}`); }, 'Membership removed');
          break;
        case 'addr-new': addrForm(); break;
        case 'addr-edit': addrForm(get('customer_address', addrId)); break;
        case 'addr-del':
          if (await confirmDialog({ title: 'Delete address?', body: 'Past orders keep the address they were shipped to.', confirm: 'delete address', danger: true }))
            attempt(() => { remove('customer_address', addrId); log('delete', 'customer_address', 'Deleted an address'); }, 'Address deleted');
          break;
      }
    });

    render();
    onChange(render);
  </script>
</AdminLayout>
