---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Orders" active="orders" crumbs={[{ label: 'Sales' }, { label: 'Orders' }]}>
  <div class="page-head">
    <div>
      <h1>Orders</h1>
      <p class="lead">Track every order from payment to delivery. Open an order to confirm payment, ship it or cancel it.</p>
    </div>
  </div>
  <section data-table></section>

  <script>
    import '../lib/boot.ts';
    import { all, get, keyOf } from '../lib/db.ts';
    import { mountTable } from '../lib/ui.ts';
    import { rupiah, esc, dateTime, badge, enumLabel } from '../lib/format.ts';
    import { orderTotal, orderItems, membershipOf } from '../lib/derive.ts';
    import { ENUMS } from '../lib/schema.ts';

    const pay = (o: any) => all('payment').find((p) => p.order_id === o.order_id);
    const ship = (o: any) => all('shipment').find((s) => s.order_id === o.order_id);
    const opts = (vals: readonly string[]) => vals.map((v) => [v, enumLabel(v)] as [string, string]);
    const qty = (o: any) => orderItems(o.order_id).reduce((s, i) => s + i.quantity, 0);

    mountTable(document.querySelector('[data-table]')!, {
      rows: () => all('orders'),
      rowKey: (r) => keyOf('orders', r),
      search: (r) => `${r.order_number} ${get('customer', r.customer_id)?.full_name} ${get('customer', r.customer_id)?.email} ${ship(r)?.tracking_number ?? ''}`,
      searchPlaceholder: 'Search order, customer, tracking number…',
      csvName: 'orders',
      pageSize: 20,
      defaultSort: { key: 'ordered_at', dir: -1 },
      filters: [
        { key: 'status', label: 'Status', options: opts(ENUMS.order_status), test: (r, v) => r.status === v },
        { key: 'payment', label: 'Payment', options: opts(ENUMS.payment_status), test: (r, v) => pay(r)?.status === v },
        { key: 'shipment', label: 'Shipping', options: opts(ENUMS.shipment_status), test: (r, v) => ship(r)?.status === v },
        { key: 'type', label: 'Type', options: opts(ENUMS.order_type), test: (r, v) => r.order_type === v },
      ],
      columns: [
        { key: 'order_number', label: 'Order', sort: (r) => r.order_number, html: (r) => `<a class="mono" href="/order?id=${r.order_id}"><b>${esc(r.order_number)}</b></a>${r.order_type === 'warranty_replacement' ? '<br><span class="badge plain">warranty replacement</span>' : ''}`, csv: (r) => r.order_number },
        { key: 'ordered_at', label: 'Date', cls: 'num', sort: (r) => r.ordered_at, html: (r) => dateTime(r.ordered_at), csv: (r) => r.ordered_at },
        {
          key: 'customer_id', label: 'Customer', sort: (r) => get('customer', r.customer_id)?.full_name ?? '',
          html: (r) => { const c = get('customer', r.customer_id); return `${esc(c?.full_name)}<br><small class="muted">${membershipOf(r.customer_id) ? 'Member' : 'Guest'}</small>`; },
          csv: (r) => get('customer', r.customer_id)?.full_name,
        },
        { key: 'items', label: 'Items', cls: 'right num', sort: qty, html: (r) => String(qty(r)), csv: qty },
        { key: 'total', label: 'Total', cls: 'right num', sort: (r) => orderTotal(r), html: (r) => `<b>${rupiah(orderTotal(r))}</b>`, csv: (r) => orderTotal(r) },
        { key: 'payment', label: 'Payment', sort: (r) => pay(r)?.status ?? '', html: (r) => (pay(r) ? badge(pay(r)!.status) : '<span class="muted">free</span>'), csv: (r) => pay(r)?.status ?? 'free' },
        { key: 'shipment', label: 'Shipping', sort: (r) => ship(r)?.status ?? '', html: (r) => (ship(r) ? badge(ship(r)!.status) : '—'), csv: (r) => ship(r)?.status ?? '' },
        { key: 'status', label: 'Status', sort: (r) => r.status, html: (r) => badge(r.status), csv: (r) => r.status },
      ],
      onRow: (r) => (location.href = `/order?id=${r.order_id}`),
    });
  </script>
</AdminLayout>
