---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Warranty claims" active="warranty-claims" crumbs={[{ label: 'After-sales' }, { label: 'Warranty claims' }]}>
  <div class="page-head">
    <div>
      <h1>Lifetime Warranty claims</h1>
      <p class="lead">Review claims for products bought online or at a retail store. Approving a claim sends the customer a free replacement.</p>
    </div>
  </div>
  <section data-table></section>

  <script>
    import '../lib/boot.ts';
    import { all, get, keyOf } from '../lib/db.ts';
    import { mountTable, openForm, attempt, toast } from '../lib/ui.ts';
    import { esc, date, dateTime, badge, enumLabel } from '../lib/format.ts';
    import { setClaimStatus, defaultShipTo } from '../lib/workflow.ts';
    import { log } from '../lib/activity.ts';
    import { icon } from '../lib/icons.ts';
    import { ENUMS, type Row } from '../lib/schema.ts';

    const source = (r: Row) => (r.order_id ? 'online' : 'retailer');

    function decide(c: Row) {
      const p = get('product', c.product_id)!;
      const cust = get('customer', c.customer_id)!;
      const o = c.order_id ? get('orders', c.order_id) : null;
      const st = c.store_id ? get('store', c.store_id) : null;
      const rep = c.replacement_order_id ? get('orders', c.replacement_order_id) : null;
      const d = document.createElement('dialog');
      d.className = 'modal';
      const photo = (u: string, l: string) => `<figure style="margin:0;display:grid;gap:6px"><img class="thumb" style="width:100%;height:120px" src="${esc(u)}" alt="${esc(l)}" loading="lazy"><figcaption class="note">${l}</figcaption></figure>`;
      const open = c.status === 'submitted' || c.status === 'under_review';
      d.innerHTML = `<form method="dialog">
        <div class="modal-head"><div><h2>${esc(c.claim_number)}</h2><p>${badge(c.status)} · submitted ${dateTime(c.submitted_at)}</p></div>
          <button class="c-btn c-btn--ghost c-btn--icon" value="x" aria-label="Close">${icon('x')}</button></div>
        <div class="modal-body">
          <div class="full cell-prod">${p.image_url ? `<img src="${esc(p.image_url)}" alt="" width="44" height="44">` : ''}<div><b>${esc(p.name)}</b><small>${esc(p.color)} · ${esc(p.size)} · <span class="mono">${esc(p.sku)}</span></small></div></div>
          <dl class="dl full">
            <dt>Customer</dt><dd><a href="/customer?id=${cust.customer_id}">${esc(cust.full_name)}</a> · ${esc(cust.email)}</dd>
            <dt>Bought at</dt><dd>${o ? `Online store · <a class="mono" href="/order?id=${o.order_id}">${esc(o.order_number)}</a>` : esc(st?.store_name ?? c.purchase_place)}</dd>
            <dt>Purchase date</dt><dd>${date(c.purchase_date)}</dd>
            <dt>Date code</dt><dd class="mono">${esc(c.date_code)}</dd>
            <dt>Issue</dt><dd>${esc(c.issue_description)}</dd>
            ${c.rejection_reason ? `<dt>Rejection reason</dt><dd class="sale">${esc(c.rejection_reason)}</dd>` : ''}
            ${rep ? `<dt>Replacement</dt><dd><a class="mono" href="/order?id=${rep.order_id}">${esc(rep.order_number)}</a> ${badge(rep.status)}</dd>` : ''}
            <dt>Resolved</dt><dd>${dateTime(c.resolved_at)}</dd>
          </dl>
          <div class="full" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">${photo(c.photo_full_url, 'Full product')}${photo(c.photo_bottom_url, 'Bottom / date code')}${photo(c.photo_defect_url, 'Defect')}</div>
        </div>
        <div class="modal-foot">${open ? `
          ${c.status === 'submitted' ? '<button type="button" class="c-btn c-btn--outline c-btn--sm" data-d="under_review">start review</button>' : ''}
          <button type="button" class="c-btn c-btn--danger c-btn--sm" data-d="rejected">reject</button>
          <button type="button" class="c-btn c-btn--sm" data-d="approved">${icon('check')} approve & send replacement</button>` : '<button class="c-btn c-btn--outline c-btn--sm" value="x">close</button>'}</div>
      </form>`;
      document.body.append(d);
      d.addEventListener('close', () => d.remove());
      d.addEventListener('click', (e) => {
        if (e.target === d) d.close();
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-d]');
        if (!b) return;
        const status = b.dataset.d!;
        d.close();
        if (status === 'under_review') {
          attempt(() => { const fx = setClaimStatus(c.warranty_claim_id, status); log('status', 'warranty_claim', `${c.claim_number} under review`, fx); return fx; }, 'Claim under review');
        } else if (status === 'rejected') {
          openForm({
            title: `Reject ${c.claim_number}`,
            fields: [{ name: 'rejection_reason', label: 'Reason', type: 'textarea', required: true, full: true, help: 'The customer will see this reason. Up to 255 characters.' }],
            submit: 'reject claim',
            danger: true,
            success: 'Claim rejected',
            onSubmit: (v) => { const fx = setClaimStatus(c.warranty_claim_id, 'rejected', { reason: String(v.rejection_reason).trim() }); log('status', 'warranty_claim', `${c.claim_number} rejected`, fx); return fx; },
          });
        } else {
          openForm({
            title: `Approve ${c.claim_number}`,
            subtitle: `A free replacement of ${esc(p.name)} (${esc(p.color)}) will be sent. In stock: ${p.stock_qty}.`,
            fields: [
              { name: 'shipping_service', label: 'Courier', type: 'select', required: true, options: ENUMS.shipping_service.map((s) => [s, enumLabel(s)] as [string, string]) },
              { name: 'recipient_name', label: 'Recipient', required: true },
              { name: 'recipient_phone', label: 'Phone', type: 'tel', required: true },
              { name: 'postal_code', label: 'Postal code', required: true },
              { name: 'street_address', label: 'Address', required: true, full: true },
              { name: 'city', label: 'City', required: true },
              { name: 'province', label: 'Province', required: true },
            ],
            values: defaultShipTo(c.customer_id),
            submit: 'approve claim',
            success: 'Claim approved',
            onSubmit: (v) => { const fx = setClaimStatus(c.warranty_claim_id, 'approved', { shipTo: v as any }); log('status', 'warranty_claim', `${c.claim_number} approved`, fx); return fx; },
          });
        }
      });
      d.showModal();
    }

    mountTable(document.querySelector('[data-table]')!, {
      rows: () => all('warranty_claim'),
      rowKey: (r) => keyOf('warranty_claim', r),
      search: (r) => `${r.claim_number} ${get('customer', r.customer_id)?.full_name} ${get('product', r.product_id)?.name} ${r.purchase_place} ${r.date_code}`,
      searchPlaceholder: 'Search claim, customer, product…',
      csvName: 'warranty-claims',
      defaultSort: { key: 'submitted_at', dir: -1 },
      filters: [
        { key: 'status', label: 'Status', options: ENUMS.claim_status.map((s) => [s, enumLabel(s)] as [string, string]), test: (r, v) => r.status === v },
        { key: 'source', label: 'Bought at', options: [['online', 'Online store'], ['retailer', 'Retail store']], test: (r, v) => source(r) === v },
      ],
      columns: [
        { key: 'claim_number', label: 'Claim', sort: (r) => r.claim_number, html: (r) => `<b class="mono">${esc(r.claim_number)}</b>`, csv: (r) => r.claim_number },
        { key: 'submitted_at', label: 'Submitted', cls: 'num', sort: (r) => r.submitted_at, html: (r) => dateTime(r.submitted_at), csv: (r) => r.submitted_at },
        { key: 'customer_id', label: 'Customer', sort: (r) => get('customer', r.customer_id)?.full_name ?? '', html: (r) => esc(get('customer', r.customer_id)?.full_name), csv: (r) => get('customer', r.customer_id)?.full_name },
        { key: 'product_id', label: 'Product', sort: (r) => get('product', r.product_id)?.name ?? '', html: (r) => { const p = get('product', r.product_id); return `<div class="cell-prod">${p?.image_url ? `<img src="${esc(p.image_url)}" alt="" loading="lazy" width="44" height="44">` : ''}<div><b>${esc(p?.name)}</b><small>${esc(p?.color)}</small></div></div>`; }, csv: (r) => get('product', r.product_id)?.name },
        { key: 'source', label: 'Bought at', sort: source, html: (r) => (r.order_id ? `<span class="badge plain">online</span><br><small class="muted mono">${esc(get('orders', r.order_id)?.order_number)}</small>` : `<span class="badge plain">retail</span><br><small class="muted">${esc(r.purchase_place)}</small>`), csv: (r) => (r.order_id ? get('orders', r.order_id)?.order_number : r.purchase_place) },
        { key: 'status', label: 'Status', sort: (r) => r.status, html: (r) => badge(r.status) + (r.replacement_order_id ? `<br><a class="mono" href="/order?id=${r.replacement_order_id}" style="font-size:12px">${esc(get('orders', r.replacement_order_id)?.order_number)}</a>` : ''), csv: (r) => r.status },
      ],
      actions: (r) => `<button type="button" class="c-btn ${r.status === 'submitted' || r.status === 'under_review' ? '' : 'c-btn--outline'} c-btn--sm" data-open>${r.status === 'submitted' || r.status === 'under_review' ? 'review' : 'view'}</button>`,
      onRow: (r) => decide(r),
    });

    document.querySelector('[data-table]')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-open]');
      if (!b) return;
      const key = b.closest('tr')!.dataset.key!;
      const row = all('warranty_claim').find((r) => keyOf('warranty_claim', r) === key);
      if (row) decide(row);
    });
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      const hit = all('warranty_claim').find((r) => r.claim_number === q);
      if (hit) decide(hit);
      else toast('Claim not found', { tone: 'bad' });
    }
  </script>
</AdminLayout>
