---
import AdminLayout from '../layouts/AdminLayout.astro';
import { ICONS } from '../lib/icons.ts';
---

<AdminLayout title="Products" active="products" crumbs={[{ label: 'Catalog' }, { label: 'Products' }]}>
  <div class="page-head">
    <div>
      <h1>Products</h1>
      <p class="lead">Every color and size is listed separately with its own SKU, price, stock and photo.</p>
    </div>
    <div class="actions">
      <button class="c-btn" type="button" data-new><Fragment set:html={ICONS.plus} /> add product</button>
    </div>
  </div>
  <section data-table></section>

  <script>
    import '../lib/boot.ts';
    import { all, get, insert, update, remove, keyOf, where } from '../lib/db.ts';
    import { mountTable, openForm, confirmDialog, attempt, rowButtons, type FieldDef } from '../lib/ui.ts';
    import { rupiah, esc, number } from '../lib/format.ts';
    import { categoryPath } from '../lib/derive.ts';
    import { log } from '../lib/activity.ts';
    import type { Row } from '../lib/schema.ts';

    const catOptions = (): Array<[number, string]> =>
      all('category')
        .map((c) => [c.category_id, categoryPath(c.category_id)] as [number, string])
        .sort((a, b) => a[1].localeCompare(b[1]));

    const fields = (): FieldDef[] => [
      { name: 'name', label: 'Product name', required: true, full: true, placeholder: 'The Quencher H2.0 FlowState Tumbler' },
      { name: 'sku', label: 'SKU', required: true, help: 'Must be unique.' },
      { name: 'category_id', label: 'Category', type: 'select', required: true, options: catOptions() },
      { name: 'color', label: 'Color', required: true, placeholder: 'Rose Quartz' },
      { name: 'size', label: 'Size', required: true, placeholder: '40 OZ' },
      { name: 'price', label: 'Price (Rp)', type: 'money', required: true, min: 0 },
      { name: 'compare_at_price', label: 'Compare-at price (Rp)', type: 'money', min: 0, help: 'Fill in when the product is on sale. Must be higher than the price.' },
      { name: 'stock_qty', label: 'Stock', type: 'number', required: true, min: 0 },
      { name: 'image_url', label: 'Image', type: 'image' },
      { name: 'description', label: 'Description', type: 'textarea', full: true },
      { name: 'is_promo_eligible', label: 'Promo codes can be used', type: 'checkbox' },
      { name: 'is_active', label: 'Visible in the store', type: 'checkbox' },
    ];

    function edit(p?: Row) {
      openForm({
        title: p ? 'Edit product' : 'Add product',
        subtitle: p ? `${esc(p.name)} · ${esc(p.color)}` : undefined,
        fields: fields(),
        values: p ?? { is_active: true, is_promo_eligible: true, stock_qty: 0 },
        submit: p ? 'save changes' : 'add product',
        success: p ? 'Product saved' : 'Product added',
        onSubmit: (v) => {
          if (p) {
            update('product', p.product_id, v);
            log('update', 'product', `Edited product ${v.name} (${v.sku})`);
          } else {
            const r = insert('product', v);
            log('create', 'product', `Added product ${r.name} (${r.sku})`);
          }
        },
      });
    }

    async function del(p: Row) {
      const reviews = where('review', (r) => r.product_id === p.product_id).length;
      const ok = await confirmDialog({
        title: 'Delete product?',
        body: `<b>${esc(p.name)}</b> · ${esc(p.color)}.${reviews ? ` Its ${reviews} review${reviews > 1 ? 's' : ''} will also be removed.` : ''} Products that have been ordered can't be deleted — hide them from the store instead.`,
        confirm: 'delete',
        danger: true,
      });
      if (!ok) return;
      attempt(() => {
        remove('product', p.product_id);
        log('delete', 'product', `Deleted product ${p.name} (${p.sku})`);
      }, 'Product deleted');
    }

    const t = mountTable(document.querySelector('[data-table]')!, {
      rows: () => all('product'),
      rowKey: (r) => keyOf('product', r),
      search: (r) => `${r.name} ${r.sku} ${r.color} ${r.size}`,
      searchPlaceholder: 'Search name, SKU, color…',
      csvName: 'products',
      defaultSort: { key: 'name', dir: 1 },
      filters: [
        {
          key: 'category',
          label: 'Category',
          options: all('category').map((c) => [String(c.category_id), categoryPath(c.category_id)] as [string, string]).sort((a, b) => a[1].localeCompare(b[1])),
          test: (r, v) => {
            let c = get('category', r.category_id);
            while (c) {
              if (String(c.category_id) === v) return true;
              c = c.parent_category_id ? get('category', c.parent_category_id) : undefined;
            }
            return false;
          },
        },
        { key: 'stock', label: 'Stock', options: [['low', 'Low (5 or less)'], ['out', 'Out of stock'], ['ok', 'In stock']], test: (r, v) => (v === 'out' ? r.stock_qty === 0 : v === 'low' ? r.stock_qty <= 5 : r.stock_qty > 5) },
        { key: 'active', label: 'Status', options: [['1', 'Active'], ['0', 'Hidden']], test: (r, v) => String(Number(r.is_active)) === v },
        { key: 'sale', label: 'Price', options: [['sale', 'On sale'], ['normal', 'Regular price']], test: (r, v) => (v === 'sale') === (r.compare_at_price != null) },
      ],
      columns: [
        {
          key: 'name', label: 'Product', sort: (r) => r.name + r.color,
          html: (r) => `<div class="cell-prod">${r.image_url ? `<img src="${esc(r.image_url)}" alt="" loading="lazy" width="44" height="44">` : '<span class="thumb"></span>'}<div><b>${esc(r.name)}</b><small>${esc(r.color)} · ${esc(r.size)} · <span class="mono">${esc(r.sku)}</span></small></div></div>`,
          csv: (r) => r.name,
        },
        { key: 'sku', label: 'SKU', hidden: true, html: () => '', csv: (r) => r.sku },
        { key: 'color', label: 'Color', hidden: true, html: () => '', csv: (r) => r.color },
        { key: 'size', label: 'Size', hidden: true, html: () => '', csv: (r) => r.size },
        { key: 'category_id', label: 'Category', sort: (r) => categoryPath(r.category_id), html: (r) => esc(categoryPath(r.category_id)), csv: (r) => categoryPath(r.category_id) },
        {
          key: 'price', label: 'Price', cls: 'right num', sort: (r) => r.price,
          html: (r) => (r.compare_at_price ? `<span class="strike">${rupiah(r.compare_at_price)}</span><span class="sale">${rupiah(r.price)}</span>` : rupiah(r.price)),
          csv: (r) => r.price,
        },
        { key: 'stock_qty', label: 'Stock', cls: 'right num', sort: (r) => r.stock_qty, html: (r) => (r.stock_qty === 0 ? '<span class="badge bad">sold out</span>' : r.stock_qty <= 5 ? `<span class="badge warn">${r.stock_qty}</span>` : number(r.stock_qty)), csv: (r) => r.stock_qty },
        { key: 'is_promo_eligible', label: 'Promo', sort: (r) => Number(r.is_promo_eligible), html: (r) => (r.is_promo_eligible && !r.compare_at_price ? '<span class="badge plain">allowed</span>' : '<span class="muted">no</span>'), csv: (r) => (r.is_promo_eligible ? 'yes' : 'no') },
        { key: 'is_active', label: 'Status', sort: (r) => Number(r.is_active), html: (r) => (r.is_active ? '<span class="badge ok">active</span>' : '<span class="badge">hidden</span>'), csv: (r) => (r.is_active ? 'active' : 'hidden') },
      ],
      actions: () => rowButtons([{ act: 'edit', label: 'Edit', ic: 'edit' }, { act: 'del', label: 'Delete', ic: 'trash' }]),
      onRow: (r) => edit(r),
    });

    document.querySelector('[data-table]')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      if (!b) return;
      const row = t.rowFromEvent(e);
      if (!row) return;
      if (b.dataset.act === 'edit') edit(row);
      if (b.dataset.act === 'del') del(row);
    });
    document.querySelector('[data-new]')!.addEventListener('click', () => edit());
    if (new URLSearchParams(location.search).get('new')) edit();
  </script>
</AdminLayout>
